# E-Commerce Data Warehouse - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to version control

# ==============================================================================
# DWH PLATFORM SELECTION
# ==============================================================================
# Set the target data warehouse platform (shorthand or full name)
# Supported values:
#   sf / snowflake   - Snowflake Data Cloud
#   bq / bigquery    - Google BigQuery (placeholder)
#   rs / redshift    - Amazon Redshift (placeholder)
#   db / databricks  - Databricks (placeholder)
#
# This can also be configured via CLI:
#   dwh config set-wh snowflake         # Global config
#   dwh config set-wh snowflake --local # Project config
DWH_PLATFORM=snowflake

# ==============================================================================
# SNOWFLAKE CONNECTION SETTINGS
# ==============================================================================

# Your Snowflake account identifier
# Format: <account_locator>.<region>.<cloud_provider> or just <account_locator>
# Example: xy12345.us-east-1.aws or xy12345
SNOWFLAKE_ACCOUNT=your_account_identifier

# Snowflake username
SNOWFLAKE_USER=your_username

# ==============================================================================
# AUTHENTICATION - Choose ONE method below
# ==============================================================================

# --- OPTION 1: Key-Pair Authentication (RSA) - RECOMMENDED ---
# Generate key: openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out ~/snowflake_key.p8 -nocrypt
# Get public key: openssl rsa -in ~/snowflake_key.p8 -pubout
# Register in Snowflake: ALTER USER your_user SET RSA_PUBLIC_KEY='...'
SNOWFLAKE_AUTHENTICATOR=keypair
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/your/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase_if_encrypted

# --- OPTION 2: Password Authentication ---
# SNOWFLAKE_AUTHENTICATOR=snowflake
# SNOWFLAKE_PASSWORD=your_password

# --- OPTION 3: Programmatic Access Token / PAT ---
# Generate from Snowflake UI: User Menu > My Profile > Programmatic access tokens
# SNOWFLAKE_AUTHENTICATOR=oauth
# SNOWFLAKE_TOKEN=your_programmatic_access_token_here

# --- OPTION 4: External Browser Authentication (OAuth/SSO) ---
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
# (No additional credentials needed - browser will open for login)

# ==============================================================================

# Snowflake warehouse name
SNOWFLAKE_WAREHOUSE=your_warehouse_name

# Database name (must exist - will NOT be created)
SNOWFLAKE_DATABASE=ecommerce_db

# Schema name (must exist - will NOT be created)
SNOWFLAKE_SCHEMA=e_mart

# Role to use for operations
SNOWFLAKE_ROLE=your_role_name

# Optional: Region (if needed for connection)
# SNOWFLAKE_REGION=us-east-1

# Note: Authenticator is set in the AUTHENTICATION section above

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (optional, defaults to console output)
# LOG_FILE=logs/app.log

# ==============================================================================
# DATA GENERATION (Optional Overrides)
# ==============================================================================
# Primary config is in: src/data_generators/datagen_config.yaml
# The YAML uses ${ENV_VAR || default} syntax - env vars override defaults.
#
# --- Initial Load Volumes ---
# DATAGEN_CUSTOMERS=500
# DATAGEN_PRODUCTS=5000
# DATAGEN_STORES=10
# DATAGEN_EMPLOYEES=50
# DATAGEN_PROMOTIONS=20
# DATAGEN_SALES=10000
# DATAGEN_CUSTOMER_INTERACTIONS=5000
# DATAGEN_LOYALTY_TRANSACTIONS=3000
# DATAGEN_INVENTORY_SNAPSHOTS=0
#
# --- Incremental Generation ---
# DATAGEN_START_DATE=2026-02-01
# DATAGEN_END_DATE=2026-02-06
# DATAGEN_NEW_CUSTOMERS=5
# DATAGEN_NEW_ORDERS=50
# DATAGEN_NEW_INTERACTIONS=50
# DATAGEN_NEW_LOYALTY=50
# DATAGEN_EXISTING_CUSTOMER_RATIO=0.4
#
# --- Date Dimension Range ---
# DATAGEN_DATES_START=2025-01-01
# DATAGEN_DATES_END=2026-12-31
#
# --- Paths ---
# DATAGEN_OUTPUT_DIR=outputs/initial_data
# DATAGEN_INCREMENTAL_OUTPUT_DIR=outputs/incremental_data
# DATAGEN_KEYS_CACHE=outputs/keys_cache.json
#
# --- Settings ---
# DATAGEN_SEED=42
# DATAGEN_VALIDATE_INTEGRITY=true
# DATAGEN_LOCALE=en_US

# ==============================================================================
# PERFORMANCE SETTINGS
# ==============================================================================

# Batch size for bulk operations
# BATCH_SIZE=10000

# Connection timeout in seconds
# CONNECTION_TIMEOUT=60

# Query timeout in seconds
# QUERY_TIMEOUT=300

# ==============================================================================
# DEVELOPMENT/TESTING FLAGS
# ==============================================================================

# Enable debug mode (more verbose logging)
# DEBUG_MODE=False

# Enable dry-run mode (don't execute SQL, just print)
# DRY_RUN=False

# Skip data validation (not recommended for production)
# SKIP_VALIDATION=False
